# Abhyas content sync - local configuration
#
# Copy this file to `.env` and fill it in:   cp .env.example .env
# `.env` is git-ignored. NEVER commit real credentials.
# In GitHub Actions these values come from repository secrets / variables
# instead (see README.md), so you only need a .env for running locally.

# ---- Required -------------------------------------------------------------

# Drive file ID of chapters-data.js (the part of its URL after /d/ ).
CHAPTERS_FILE_ID=10_YqLKsxxIUR8TlTA5vmOKK5xcOIeI8C

# Service-account key. Use ONE of the two options below.
#
# Option A (recommended locally): path to the downloaded key file. Keep the
# file outside the repo, or under a name the .gitignore already covers
# (service-account*.json).
GDRIVE_CREDENTIALS_FILE=./service-account.json
#
# Option B: the whole JSON on ONE line, in single quotes. Raw JSON or the same
# JSON base64-encoded both work.
# GDRIVE_CREDENTIALS='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"sync-bot@your-project.iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# ---- Optional -------------------------------------------------------------

# Parallel downloads (1-32). 8 is a good default; lower it if Drive rate-limits you.
SYNC_WORKERS=8

# Re-download every file even if Drive says it is unchanged.
# FORCE_FULL=1

# Allow chapters-data.js to drop most of its files (the guard otherwise refuses
# to prune the mirror if the tree shrinks by more than half).
# ALLOW_SHRINK=1
